{
    "version": "2.1.0",
    "description": "WireGuard and AmneziaWG VPN client with auto-tunneling, a kill switch, and proxying",
    "homepage": "https://wgtunnel.com",
    "license": "MIT",
    "architecture": {
        "64bit": {
            "url": "https://github.com/wgtunnel/desktop/releases/download/v2.1.0/wgtunnel-2.1.0-win-x64-nsis.exe#/installer.exe",
            "hash": "0d5bb5ebb52032585ed0f08d655888b3800aab112a85a64573a1d7d8a1444757"
        }
    },
    "installer": {
        "script": [
            "if (!(is_admin)) {",
            "    error \"Administrator rights are required to install $app.\"",
            "    break",
            "}",
            "",
            "Invoke-ExternalCommand \"$dir\\installer.exe\" -ArgumentList @('/S', \"/D=$dir\") -RunAs | Out-Null",
            "Remove-Item -Recurse -ErrorAction SilentlyContinue \"$([Environment]::GetFolderPath('commonstartmenu'))\\Programs\\WG Tunnel\"",
            "Remove-Item \"$dir\\installer.exe\""
        ]
    },
    "uninstaller": {
        "script": "Start-Process \"$dir\\Uninstall wgtunnel.exe\" -ArgumentList @('/S') -Verb RunAs -Wait | Out-Null"
    },
    "bin": "wgtunnel.exe",
    "shortcuts": [
        [
            "wgtunnel.exe",
            "WG Tunnel"
        ]
    ],
    "checkver": {
        "github": "https://github.com/wgtunnel/desktop",
        "regex": "/releases/tag/(?<tag>v?(?<version>[\\d.]+))"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/wgtunnel/desktop/releases/download/$matchTag/wgtunnel-$version-win-x64-nsis.exe#/installer.exe"
            }
        }
    }
}
